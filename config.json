{
  "enabled": true,
  "dry_run": false,
  "process_names": [
    "Antigravity.exe"
  ],
  "window_title_regex": "",
  "include_minimized": false,
  "scan_child_windows": true,
  "max_child_windows": 80,
  "min_child_window_size": 80,
  "labels": [
    "allow",
    "allow once",
    "allow always",
    "always allow",
    "allow all",
    "allow for this session",
    "accept",
    "accept all",
    "approve",
    "approve once",
    "always approve",
    "yes",
    "yes allow",
    "yes, allow",
    "ok",
    "okay",
    "continue",
    "resume",
    "run",
    "run command",
    "run anyway",
    "retry",
    "submit",
    "confirm",
    "proceed",
    "trust",
    "grant",
    "apply",
    "keep",
    "keep changes",
    "do it",
    "go ahead",
    "agree",
    "allow this time",
    "yes, allow this time",
    "yes, and always allow",
    "allow for this conversation",
    "allow for this project",
    "always allow this"
  ],
  "block_labels": [
    "cancel",
    "reject",
    "reject all",
    "deny",
    "deny once",
    "decline",
    "no",
    "no thanks",
    "stop",
    "abort",
    "quit",
    "exit",
    "close",
    "dismiss",
    "skip",
    "delete",
    "discard",
    "undo",
    "revert",
    "remove",
    "disable",
    "ignore",
    "later",
    "never",
    "not now",
    "don't allow",
    "dont allow",
    "don't save",
    "dont save",
    "no, don't",
    "block",
    "no (tell the agent",
    "tell the agent what to do instead"
  ],
  "match_mode": "smart",
  "control_types": [
    "ButtonControl",
    "HyperlinkControl",
    "MenuItemControl",
    "SplitButtonControl",
    "CheckBoxControl",
    "RadioButtonControl",
    "ListItemControl"
  ],
  "poll_interval_seconds": 0.5,
  "max_poll_interval_seconds": 2.0,
  "min_seconds_between_clicks": 0.8,
  "max_clicks_per_minute": 40,
  "dedupe_seconds": 3.0,
  "max_attempts_per_button": 3,
  "suppress_seconds_after_failed_attempts": 30.0,
  "same_label_group_cooldown": 10.0,
  "click_mode": "auto",
  "restore_foreground_after_click": true,
  "restore_cursor_after_click": true,
  "accessibility_check": true,
  "accessibility_min_elements": 10,
  "accessibility_empty_streak": 4,
  "accessibility_nudge": true,
  "accessibility_nudge_cooldown_seconds": 60.0,
  "auto_relaunch_on_empty": false,
  "auto_relaunch_cooldown_seconds": 180.0,
  "max_name_length": 250,
  "min_rect_width": 10,
  "max_rect_width": 1200,
  "min_rect_height": 8,
  "max_rect_height": 300,
  "require_on_screen": true,
  "max_elements_per_scan": 4000,
  "notify_on_click": true,
  "notify_min_seconds": 4.0,
  "log_file": "logs/agy_auto_allow.log",
  "log_level": "INFO",
  "log_max_bytes": 1000000,
  "log_backup_count": 3,
  "hotkeys": {
    "toggle": "ctrl+alt+a",
    "discover": "ctrl+alt+d",
    "open_log": "ctrl+alt+l",
    "quit": "ctrl+alt+q"
  },
  "image_fallback": {
    "enabled": false,
    "templates_dir": "assets/templates",
    "threshold": 0.9,
    "max_matches": 5
  }
}
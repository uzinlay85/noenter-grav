# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Logs and dynamic dumps
logs/*
!logs/.gitkeep

# Screenshots generated by --grab
assets/screenshots/

# Temporary files & OS specific
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor / IDE configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
